generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model tb_users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @db.DateTime(0) @map("createdAt")
  updatedAt DateTime @db.DateTime(0) @map("updatedAt")

  @@map("tb_users")
}

model tbl_accounts {
  id                      Int    @id @default(autoincrement())
  user_name               String @db.VarChar(25)
  user_password           String @db.VarChar(255)
  identities_account_attr Int?

  @@index([identities_account_attr])
  @@map("tbl_accounts")
}

model tbl_account_info {
  id_accounts Int    @id @default(autoincrement())
  username    String @db.VarChar(25)
  email       String @db.VarChar(25)
  description String @db.Text

  @@map("tbl_account_info")
}